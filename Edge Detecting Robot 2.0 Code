// 📶 WI-FI ACCESS POINT CREDENTIALS
// ==========================================
const char* AP_SSID = "Robot-Control";
const char* AP_PASS = "12345678"; 

// Identity Name for Discovery
const char* ROBOT_NAME = "edge detecting robot 2.0";

WebServer server(80);

// --- ESP-NOW SIMPLE COMMAND DATA ---
struct CommandMessage {
  char cmd[16];
};

struct IdentityMessage {
  char name[32];
};

CommandMessage incomingCmd;
IdentityMessage robotIdentity;

unsigned long lastEspNowPacketTime = 0;
String espNowManualCmd = "STOP";
uint8_t controllerMac[6];
bool controllerKnown = false;

// --- MOTOR DIRECTION FIX ---
#define INVERT_LEFT_MOTOR   false   
#define INVERT_RIGHT_MOTOR  false   

// --- PIN DEFINITIONS ---
#define PIN_ENA      14
#define PIN_IN1      27
#define PIN_IN2      26
#define PIN_IN3      25
#define PIN_IN4      33 

#define XSHUT_LEFT   17  
#define XSHUT_RIGHT  18  

#define BUTTON_PIN   4
#define BUZZER_PIN   19

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// --- THRESHOLDS & SPEEDS ---
#define THRESHOLD_LEFT_MM  220 
#define THRESHOLD_RIGHT_MM 160 

#define AUTO_FWD_SPEED    170  
#define AUTO_BACK_SPEED   180  
#define AUTO_TURN_SPEED   240  

#define MANUAL_FWD_SPEED  190  
#define MANUAL_BACK_SPEED 200  
#define MANUAL_TURN_SPEED 255  

#define MAX_KMH           1.8 

#define STOP_TIME         1500  
#define BACKWARD_TIME     600   
#define TURN_TIME         800   

// --- OBJECTS & GLOBALS ---
Adafruit_VL53L0X lox_left = Adafruit_VL53L0X();
Adafruit_VL53L0X lox_right = Adafruit_VL53L0X();

bool leftSensorOK = false;
bool rightSensorOK = false;
bool screenOK = false;

int distLeft = 0;
int distRight = 0;
int currentPWM = 0; 

int currentMode = 0; // 0: Auto, 1: Manual+Safety, 2: Suicide, 3: Diagnostics
unsigned long lastBtnPress = 0;
String currentManualCmd = "STOP"; 

enum DangerState { IDLE, STOP1, BACKWARD, STOP2, TURN, STOP3 };
DangerState dangerState = IDLE;
unsigned long stateStartTime = 0;
bool dangerLeftDetected = false;
bool dangerRightDetected = false;

