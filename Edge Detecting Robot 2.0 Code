// --- ESP-NOW RECEIVE & IDENTITY RESPONSE ---
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  if (len == sizeof(CommandMessage)) {
    memcpy(&incomingCmd, incomingData, sizeof(incomingCmd));
    espNowManualCmd = String(incomingCmd.cmd);
    lastEspNowPacketTime = millis();

    // Register controller peer if not registered so we can reply back with robot name
    if (!controllerKnown && recv_info->src_addr != NULL) {
      memcpy(controllerMac, recv_info->src_addr, 6);
      
      esp_now_peer_info_t peerInfo = {};
      memcpy(peerInfo.peer_addr, controllerMac, 6);
      peerInfo.channel = 0;
      peerInfo.encrypt = false;
      
      if (esp_now_add_peer(&peerInfo) == ESP_OK) {
        controllerKnown = true;
      }
    }

    // Send back identity name payload to controller
    if (controllerKnown) {
      strncpy(robotIdentity.name, ROBOT_NAME, sizeof(robotIdentity.name));
      esp_now_send(controllerMac, (uint8_t *)&robotIdentity, sizeof(robotIdentity));
    }
  }
}

// --- MOTOR FUNCTIONS ---
void setupMotors() {
  pinMode(PIN_IN1, OUTPUT);
  pinMode(PIN_IN2, OUTPUT);
  pinMode(PIN_IN3, OUTPUT);
  pinMode(PIN_IN4, OUTPUT);
  ledcAttach(PIN_ENA, 5000, 8); 
}

void stopMotors() {
  currentPWM = 0;
  ledcWrite(PIN_ENA, 0);
  digitalWrite(PIN_IN1, LOW); digitalWrite(PIN_IN2, LOW);
  digitalWrite(PIN_IN3, LOW); digitalWrite(PIN_IN4, LOW);
}

void setLeftMotor(bool fwd) {
  if (INVERT_LEFT_MOTOR) fwd = !fwd;
  digitalWrite(PIN_IN1, fwd ? HIGH : LOW);
  digitalWrite(PIN_IN2, fwd ? LOW : HIGH);
}

void setRightMotor(bool fwd) {
  if (INVERT_RIGHT_MOTOR) fwd = !fwd;
  digitalWrite(PIN_IN3, fwd ? HIGH : LOW);
  digitalWrite(PIN_IN4, fwd ? LOW : HIGH);
}

void forward(int spd) {
  currentPWM = spd;
  ledcWrite(PIN_ENA, spd);
  setLeftMotor(true);
  setRightMotor(true);
}

void backward(int spd) {
  currentPWM = spd;
  ledcWrite(PIN_ENA, spd);
  setLeftMotor(false);
  setRightMotor(false);
}

void turnLeftTank(int spd) {
  currentPWM = spd;
  ledcWrite(PIN_ENA, spd);
  digitalWrite(PIN_IN1, LOW); digitalWrite(PIN_IN2, LOW);
  setRightMotor(true);                                    
}

void turnRightTank(int spd) {
  currentPWM = spd;
  ledcWrite(PIN_ENA, spd);
  setLeftMotor(true);                                     
  digitalWrite(PIN_IN3, LOW); digitalWrite(PIN_IN4, LOW); 
}

// --- AUDIO HELPERS ---
void setupBuzzer() {
  ledcAttach(BUZZER_PIN, 2000, 8); 
}

void playBeep(int freq, int duration) {
  ledcWriteTone(BUZZER_PIN, freq);
  delay(duration);
  ledcWriteTone(BUZZER_PIN, 0);
}

void muteBuzzer() {
  ledcWriteTone(BUZZER_PIN, 0);
}

// --- UI FUNCTIONS ---
void drawSpeedometerUI(String modeTitle) {
  if (!screenOK) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.print(modeTitle);
  
  float currentKmh = (currentPWM / 255.0) * MAX_KMH;
  
  display.setTextSize(2);
  display.setCursor(0, 16);
  display.print(currentKmh, 1);
  display.setTextSize(1);
  display.print(" km/h");

  int barWidth = map(currentPWM, 0, 255, 0, 124);
  display.drawRect(0, 42, 128, 12, SSD1306_WHITE);
  display.fillRect(2, 44, barWidth, 8, SSD1306_WHITE);

  display.display();
}

void drawDiagnosticsUI() {
  if (!screenOK) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  display.setCursor(0, 0);
  display.println("--- DIAGNOSTICS ---");

  display.setCursor(0, 14);
  display.print("L Laser: "); 
  if (leftSensorOK) { display.print(distLeft); display.println(" mm"); }
  else { display.println("ERR"); }

  display.setCursor(0, 26);
  display.print("R Laser: "); 
  if (rightSensorOK) { display.print(distRight); display.println(" mm"); }
  else { display.println("ERR"); }

  display.setCursor(0, 38);
  display.print("WiFi AP: ");
  display.println(WiFi.softAPgetStationNum() > 0 ? "CONNECTED" : "WAITING");

  display.setCursor(0, 50);
  display.print("ESP-NOW: ");
  display.println((millis() - lastEspNowPacketTime < 1000) ? "LINK OK" : "NO LINK");

  display.display();
}

int readLeftSingle() {
  if (!leftSensorOK) return 0;
  VL53L0X_RangingMeasurementData_t measure;
  lox_left.rangingTest(&measure, false);
  return (measure.RangeStatus != 4) ? measure.RangeMilliMeter : 0;
}

int readRightSingle() {
  if (!rightSensorOK) return 0;
  VL53L0X_RangingMeasurementData_t measure;
  lox_right.rangingTest(&measure, false);
  return (measure.RangeStatus != 4) ? measure.RangeMilliMeter : 0;
}

void runAutonomousSequence(bool dangerL, bool dangerR, unsigned long now);

void handleRoot() {
  server.send(200, "text/html", HTML_PAGE);
}

void handleCommand() {
  if (currentMode == 0 || currentMode == 3) {
    server.send(200, "text/plain", "Ignored");
    return;
  }

  if (currentMode == 1 && dangerState != IDLE) {
    server.send(200, "text/plain", "Safety Active");
    return;
  }

  if (server.hasArg("dir")) {
    currentManualCmd = server.arg("dir"); 
  }
  server.send(200, "text/plain", "OK");
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n>>> ESP32 BOOTING <<<");

  setupMotors();
  stopMotors();

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  setupBuzzer();

  Wire.begin(21, 22);
  Wire.setTimeOut(50); 

  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C) || display.begin(SSD1306_SWITCHCAPVCC, 0x3D)) {
    screenOK = true;
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, 10);
    display.println("INIT SENSORS...");
    display.display();
  }

  pinMode(XSHUT_LEFT, OUTPUT);
  pinMode(XSHUT_RIGHT, OUTPUT);
  digitalWrite(XSHUT_LEFT, LOW);
  digitalWrite(XSHUT_RIGHT, LOW);
  delay(20);

  digitalWrite(XSHUT_LEFT, HIGH);
  delay(20);
  if (lox_left.begin(0x30)) leftSensorOK = true;

  digitalWrite(XSHUT_RIGHT, HIGH);
  delay(20);
  if (lox_right.begin(0x31)) rightSensorOK = true;

  playBeep(1000, 100);
  
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);

  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(OnDataRecv);
    Serial.println("ESP-NOW Ready!");
  }

  server.on("/", handleRoot);
  server.on("/cmd", handleCommand);
  server.begin();

  Serial.println(">>> SETUP COMPLETE <<<");
}

void loop() {
  unsigned long now = millis();

  if (digitalRead(BUTTON_PIN) == LOW && (now - lastBtnPress > 250)) {
    lastBtnPress = now;
    currentMode = (currentMode + 1) % 4;
    
    stopMotors();
    currentManualCmd = "STOP";
    dangerState = IDLE;
    muteBuzzer();
    playBeep(700, 50);
  }

  server.handleClient();

  if (dangerState == IDLE) {
    distLeft = readLeftSingle();
    distRight = readRightSingle();
  }

  bool dangerL = leftSensorOK && (distLeft > THRESHOLD_LEFT_MM);
  bool dangerR = rightSensorOK && (distRight > THRESHOLD_RIGHT_MM);

  String activeCmd = "STOP";
  if (currentManualCmd != "STOP") {
    activeCmd = currentManualCmd;
  } else if (now - lastEspNowPacketTime < 500) {
    activeCmd = espNowManualCmd;
  }

  switch (currentMode) {
    case 0:
      runAutonomousSequence(dangerL, dangerR, now);
      drawSpeedometerUI("MODE: AUTONOMOUS");
      break;

    case 1:
      if (dangerState != IDLE || dangerL || dangerR) {
        runAutonomousSequence(dangerL, dangerR, now);
      } else {
        if (activeCmd == "FORWARD") forward(MANUAL_FWD_SPEED);
        else if (activeCmd == "BACK") backward(MANUAL_BACK_SPEED);
        else if (activeCmd == "LEFT") turnRightTank(MANUAL_TURN_SPEED);
        else if (activeCmd == "RIGHT") turnLeftTank(MANUAL_TURN_SPEED);
        else if (activeCmd == "FORWARD_LEFT") turnRightTank(MANUAL_TURN_SPEED);
        else if (activeCmd == "FORWARD_RIGHT") turnLeftTank(MANUAL_TURN_SPEED);
        else if (activeCmd == "BACK_LEFT") turnRightTank(MANUAL_TURN_SPEED);
        else if (activeCmd == "BACK_RIGHT") turnLeftTank(MANUAL_TURN_SPEED);
        else stopMotors();
      }
      drawSpeedometerUI("MODE: MANUAL+SAFE");
      break;

    case 2:
      dangerState = IDLE;
      muteBuzzer();
      if (activeCmd == "FORWARD") forward(MANUAL_FWD_SPEED);
      else if (activeCmd == "BACK") backward(MANUAL_BACK_SPEED);
      else if (activeCmd == "LEFT") turnRightTank(MANUAL_TURN_SPEED);
      else if (activeCmd == "RIGHT") turnLeftTank(MANUAL_TURN_SPEED);
      else if (activeCmd == "FORWARD_LEFT") turnRightTank(MANUAL_TURN_SPEED);
      else if (activeCmd == "FORWARD_RIGHT") turnLeftTank(MANUAL_TURN_SPEED);
      else if (activeCmd == "BACK_LEFT") turnRightTank(MANUAL_TURN_SPEED);
      else if (activeCmd == "BACK_RIGHT") turnLeftTank(MANUAL_TURN_SPEED);
      else stopMotors();
      
      drawSpeedometerUI("MODE: SUICIDE");
      break;

    case 3:
      stopMotors();
      muteBuzzer();
      drawDiagnosticsUI();
      break;
  }

  delay(10);
}

void runAutonomousSequence(bool dangerL, bool dangerR, unsigned long now) {
  switch (dangerState) {
    case IDLE:
      if (dangerL || dangerR) {
        dangerLeftDetected = dangerL;
        dangerRightDetected = dangerR;
        stopMotors();
        playBeep(2000, 100);
        dangerState = STOP1;
        stateStartTime = now;
      } else if (currentMode == 0) {
        forward(AUTO_FWD_SPEED); 
      }
      break;

    case STOP1:
      stopMotors();
      if (now - stateStartTime >= STOP_TIME) {
        backward(AUTO_BACK_SPEED); 
        dangerState = BACKWARD;
        stateStartTime = now;
      }
      break;

    case BACKWARD:
      if (now - stateStartTime >= BACKWARD_TIME) {
        stopMotors();
        dangerState = STOP2;
        stateStartTime = now;
      }
      break;

    case STOP2:
      stopMotors();
      if (now - stateStartTime >= STOP_TIME) {
        dangerState = TURN;
        stateStartTime = now;
      }
      break;

    case TURN:
      unsigned long activeTurnDuration;
      if (dangerLeftDetected && dangerRightDetected) {
        turnRightTank(AUTO_TURN_SPEED); 
        activeTurnDuration = TURN_TIME * 2; 
      } else if (dangerRightDetected) {
        turnRightTank(AUTO_TURN_SPEED);  
        activeTurnDuration = TURN_TIME; 
      } else {
        turnLeftTank(AUTO_TURN_SPEED); 
        activeTurnDuration = TURN_TIME; 
      }

      if (now - stateStartTime >= activeTurnDuration) {
        stopMotors();
        dangerState = STOP3;
        stateStartTime = now;
      }
      break;

    case STOP3:
      stopMotors();
      if (now - stateStartTime >= STOP_TIME) {
        muteBuzzer();
        dangerLeftDetected = false;
        dangerRightDetected = false;
        dangerState = IDLE;
      }
      break;
  }
}
